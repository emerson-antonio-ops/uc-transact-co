POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transactco
POSTGRES_USER=transactco
POSTGRES_PASSWORD=transactco

# Read-only role used by `make land`. It has SELECT on public.* and no access to _control.
ANALYTICS_RO_USER=analytics_ro
ANALYTICS_RO_PASSWORD=analytics_ro

DUCKDB_PATH=warehouse.duckdb

# Same seed reproduces the generation logic. The current partial day is anchored
# to seed time, so exact final row counts can differ slightly across laptops.
TRANSACTCO_SEED=20260810
SEED_DAYS=90
SEED_CUSTOMERS=5000
SEED_PRODUCTS=400
SEED_ORDERS_PER_DAY=600
